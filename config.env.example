# Configuration of the knowledge base. /knowledge-base:setup copies this file to
# ~/.config/knowledge-base/config.env (mode 600). Variables set in the environment take
# precedence over this file.

# --- Database ---
# Default (DATABASE_URL unset): a SQLite file, no server needed:
#   ~/.local/share/knowledge-base/knowledge.db ($XDG_DATA_HOME/knowledge-base/knowledge.db)
# Another SQLite file:      DATABASE_URL=sqlite:///absolute/path/knowledge.db
# Postgres with pgvector:   DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require
#   (e.g. a server shared by a team; /knowledge-base:setup --database-url URL)
#DATABASE_URL=

# --- Local Postgres in Docker (only with /knowledge-base:setup --postgres) ---
# setup fills these in, with a random password, and sets DATABASE_URL accordingly.
#POSTGRES_USER=kb
#POSTGRES_PASSWORD=
#POSTGRES_DB=knowledge_base
#POSTGRES_PORT=5433
# KB_CONTAINER_NAME=knowledge-base-postgres
# Tuning for a larger knowledge base (defaults shown); raise on machines with more memory.
# POSTGRES_SHARED_BUFFERS=512MB
# POSTGRES_MAINTENANCE_WORK_MEM=512MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
# POSTGRES_SHM_SIZE=1gb

# --- Embeddings ---
# Any OpenAI-compatible API (/embeddings).
# Default: Ollama on the host (ollama pull bge-m3)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
# Fixed in the schema on first start. Known models get the right default automatically
# (bge-m3: 1024, nomic-embed-text: 768); other models need it set here.
# Switching models later requires a reindex (see README, "Embedding model")
# EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
# Prefixes: taken from the model profile (nomic-embed-text: "search_document: " / "search_query: ",
# bge-m3: none). Only set to override (empty = no prefix). Changing them requires re-embedding.
# EMBEDDING_DOC_PREFIX=
# EMBEDDING_QUERY_PREFIX=

# Similarity thresholds (cosine) are calibrated per model; override after calibrating your own.
# KB_HOOK_MIN_SIM=0.52     # minimum similarity for the retrieval hook to inject an entry
# KB_SIMILAR_MIN_SIM=0.70  # from here on an existing entry counts as "similar" to a new fact

# Chunking (characters)
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
