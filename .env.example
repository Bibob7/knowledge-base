# --- Postgres (docker compose) ---
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb
POSTGRES_DB=knowledge_base
POSTGRES_PORT=5433
# KB_CONTAINER_NAME=knowledge-base-postgres

# --- MCP-Server ---
DATABASE_URL=postgres://kb:kb@localhost:5433/knowledge_base?sslmode=disable

# Embeddings: beliebige OpenAI-kompatible API (/embeddings).
# Default: Ollama auf dem Host (ollama pull nomic-embed-text)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# Muss zur Modell-Dimension passen. Wird beim ersten Start im Schema fixiert.
EMBEDDING_DIM=768
EMBEDDING_API_KEY=
# Praefixe: fuer nomic-embed-text automatisch "search_document: " / "search_query: ".
# Nur setzen, um zu ueberschreiben (leer = kein Praefix). Aenderung erfordert Neu-Einbettung.
# EMBEDDING_DOC_PREFIX=
# EMBEDDING_QUERY_PREFIX=

# Chunking (Zeichen)
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
