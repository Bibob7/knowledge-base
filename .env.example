# --- Postgres (docker compose) ---
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb
POSTGRES_DB=knowledge_base
POSTGRES_PORT=5433
# KB_CONTAINER_NAME=knowledge-base-postgres

# --- MCP-Server ---
DATABASE_URL=postgres://kb:kb@localhost:5433/knowledge_base?sslmode=disable

# Embeddings: beliebige OpenAI-kompatible API (/embeddings).
# Default: Ollama on the host (ollama pull nomic-embed-text)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# Must match the model's dimension. Fixed in the schema on first start.
EMBEDDING_DIM=768
EMBEDDING_API_KEY=
# Prefixes: set automatically for nomic-embed-text ("search_document: " / "search_query: ").
# Only set to override (empty = no prefix). Changing them requires re-embedding.
# EMBEDDING_DOC_PREFIX=
# EMBEDDING_QUERY_PREFIX=

# Chunking (characters)
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
